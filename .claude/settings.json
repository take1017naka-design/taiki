{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./data/**)",
      "Read(./raw/**)",
      "Read(./private/**)",
      "Read(./secret/**)",
      "Read(./出力/**)",
      "Read(./患者/**)",
      "Read(./院内/**)",
      "Read(**/*.dcm)",
      "Read(**/*.nii)",
      "Read(**/*.nii.gz)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials.json)"
    ]
  }
}
